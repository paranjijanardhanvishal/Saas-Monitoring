# ---------------------------------------------------------------------------
# SaaS Security Monitor - environment template
# Copy to .env and replace every placeholder. Never commit the real .env.
# ---------------------------------------------------------------------------

# Application
PROJECT_NAME="SaaS Security Monitor"
APP_ENV=development
API_V1_STR=/api

# MongoDB. For a local demo use localhost; for Atlas use an SRV URI.
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=saas_monitor

# Browser origins allowed by CORS (comma separated, exact scheme/host/port).
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Authentication. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production startup fails if this is missing or shorter than 32 characters.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Set to true when the frontend is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Server-to-server credential for the SaaS proxy. The proxy sends it as
# X-Ingestion-Key. Leave empty to disable SaaS proxy ingestion entirely.
INGESTION_API_KEY=

# PII engine: auto | presidio | regex
# auto uses Presidio when installed (see backend/requirements-ml.txt) and
# falls back to regex. The active engine is reported by the API/system health.
PII_ENGINE=auto
PII_MAX_TEXT_LENGTH=100000

# Optional local OCR. Install backend/requirements-ocr.txt and Tesseract first.
TESSERACT_CMD=
OCR_MAX_FILE_BYTES=10485760
OCR_MAX_PAGES=10

# Agent liveness and automatic risk evaluation
AGENT_HEARTBEAT_STALE_SECONDS=180
AUTO_RISK_ENABLED=true

# Data retention (days). 0 disables automatic deletion.
EVENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# Optional integrations. HTTPS URLs are required; unset means disabled.
SLACK_WEBHOOK_URL=
JIRA_API_URL=
JIRA_AUTH_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Incident
