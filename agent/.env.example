# Backend API base URL. HTTPS is required outside loopback development.
BACKEND_URL=https://monitor.example.com/api

# One-time, device-scoped enrollment token issued from the dashboard/API after
# monitoring consent is ALLOWED. It is consumed once and never stored.
AGENT_ENROLLMENT_TOKEN=

# Local state directory for the device credential. Keep it user-only.
# Defaults to %LOCALAPPDATA%\SaaSMonitorAgent on Windows.
AGENT_STATE_DIR=

HEARTBEAT_INTERVAL=60
POLL_INTERVAL=5
USAGE_REPORT_INTERVAL=300
EVENT_BATCH_SIZE=100

# File monitoring observes names/sizes only inside these directories.
# Semicolon-separated. Defaults to Documents, Desktop and Downloads.
AGENT_ENABLE_FILE_MONITORING=true
AGENT_WATCH_DIRS=

# Requires an elevated agent to read Windows Security event 4625.
AGENT_ENABLE_FAILED_LOGIN_MONITORING=true

AGENT_LOG_LEVEL=INFO
