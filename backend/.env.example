# The backend loads ../.env first and then .env, so this file is optional.
# Keep one source of truth in the repository root .env.
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=saas_monitor
APP_ENV=development
API_V1_STR=/api
PROJECT_NAME="SaaS Security Monitor"
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
INGESTION_API_KEY=
PII_ENGINE=auto
PII_MAX_TEXT_LENGTH=100000
TESSERACT_CMD=
OCR_MAX_FILE_BYTES=10485760
OCR_MAX_PAGES=10
AGENT_HEARTBEAT_STALE_SECONDS=180
AUTO_RISK_ENABLED=true
EVENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# Optional integrations
SLACK_WEBHOOK_URL=
JIRA_API_URL=
JIRA_AUTH_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Incident
